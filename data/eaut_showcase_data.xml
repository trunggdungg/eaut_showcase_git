<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- SEQUENCES (sinh tự động project_code)                         -->
    <!-- ============================================================ -->
    <record id="seq_eaut_showcase_project" model="ir.sequence">
        <field name="name">UIKick Project Code</field>
        <field name="code">eaut_showcase.project</field>
        <field name="padding">0</field>
        <field name="number_next">13</field>
        <field name="number_increment">1</field>
    </record>

    <!-- ============================================================ -->
    <!-- CATEGORIES (cấu hình danh mục)                                -->
    <!-- ============================================================ -->
    <record id="cat_camera_equipment" model="eaut_showcase.category">
        <field name="name">Camera Equipment</field>
        <field name="sequence">10</field>
    </record>
    <record id="cat_apps" model="eaut_showcase.category">
        <field name="name">Apps</field>
        <field name="sequence">20</field>
    </record>
    <record id="cat_technology" model="eaut_showcase.category">
        <field name="name">Technology</field>
        <field name="sequence">30</field>
    </record>
    <record id="cat_design" model="eaut_showcase.category">
        <field name="name">Design</field>
        <field name="sequence">40</field>
    </record>
    <record id="cat_health_fitness" model="eaut_showcase.category">
        <field name="name">Health &amp; Fitness</field>
        <field name="sequence">50</field>
    </record>
    <record id="cat_product_design" model="eaut_showcase.category">
        <field name="name">Product Design</field>
        <field name="sequence">60</field>
    </record>

    <!-- ============================================================ -->
    <!-- STATUSES (cấu hình trạng thái bài đăng)                       -->
    <!-- ============================================================ -->
    <record id="status_live" model="eaut_showcase.status">
        <field name="name">Live</field>
        <field name="sequence">10</field>
    </record>
    <record id="status_upcoming" model="eaut_showcase.status">
        <field name="name">Upcoming</field>
        <field name="sequence">20</field>
    </record>

