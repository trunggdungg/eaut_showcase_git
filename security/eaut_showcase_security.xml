<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_eaut_showcase" model="ir.module.category">
        <field name="name">EAUT Showcase</field>
        <field name="description">Quản lý dự án sinh viên và đăng ký chọn giảng viên hướng dẫn đồ án</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_eaut_showcase" model="res.groups.privilege">
        <field name="name">EAUT Showcase</field>
        <field name="category_id" ref="module_category_eaut_showcase"/>
    </record>

    <!-- Nhóm trống — chỉ để dropdown "EAUT Showcase" trong form User có 3 mức
         rõ ràng: Không có quyền / Người dùng / Quản lý — bản thân nhóm này
         KHÔNG cấp thêm quyền dữ liệu hay quyền thấy app (những cái đó vẫn chỉ
         dành riêng cho nhóm Quản lý bên dưới). -->
    <record id="group_eaut_showcase_user" model="res.groups">
        <field name="name">Người dùng</field>
        <field name="privilege_id" ref="privilege_eaut_showcase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_eaut_showcase_manager" model="res.groups">
        <field name="name">Quản lý</field>
        <field name="privilege_id" ref="privilege_eaut_showcase"/>
        <field name="implied_ids" eval="[(4, ref('group_eaut_showcase_user'))]"/>
    </record>

    <!-- Administrator luôn có quyền Quản lý của app này -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_eaut_showcase_manager'))]"/>
    </record>

</odoo>
