<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_showcase_creator_list" model="ir.ui.view">
        <field name="name">eaut_showcase.creator.list</field>
        <field name="model">eaut_showcase.creator</field>
        <field name="arch" type="xml">
            <list string="Tác giả">
                <field name="name"/>
                <field name="role"/>
                <field name="location_id"/>
                <field name="project_count"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_showcase_creator_form" model="ir.ui.view">
        <field name="name">eaut_showcase.creator.form</field>
        <field name="model">eaut_showcase.creator</field>
        <field name="arch" type="xml">
            <form string="Tác giả">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_projects" type="object"
                                class="oe_stat_button" icon="fa-folder-open">
                            <field name="project_count" widget="statinfo" string="Dự án"/>
                        </button>
                    </div>
                    <field name="avatar" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Tên tác giả / nhóm"/>
                        </h1>
                        <field name="role" placeholder="VD: Trưởng nhóm, Kỹ sư phần mềm..."/>
                    </div>
                    <group>
                        <group>
                            <field name="location_id"/>
                            <field name="email"/>
                            <field name="website_url"/>
                            <field name="user_id" readonly="1"/>
                            <button name="action_create_portal_user" type="object"
                                    string="Tạo tài khoản Portal" class="btn-link"
                                    invisible="user_id"/>
                            <field name="category_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Giới thiệu">
                            <field name="bio" nolabel="1" placeholder="Giới thiệu ngắn về tác giả/nhóm..."/>
                        </page>
                    </notebook>
<!--                    <group string="Giới thiệu">-->
<!--                        <field name="bio" nolabel="1" placeholder="Giới thiệu ngắn về tác giả/nhóm..."/>-->
<!--                    </group>-->
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eaut_showcase_creator" model="ir.actions.act_window">
        <field name="name">Tác giả</field>
        <field name="res_model">eaut_showcase.creator</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo tác giả/nhóm thực hiện để gắn vào các dự án
            </p>
        </field>
    </record>

</odoo>