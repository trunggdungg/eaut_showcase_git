<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="project_card" name="EAUT Showcase - Project Card">
        <a t-att-href="'/showcase/project/' + project.project_code" class="uikick-card">
            <div class="uikick-card-media">
                <!--                                        <img t-att-src="project.image" t-att-alt="project.title"-->
                <!--                                             class="uikick-card-img"/>-->
                <img t-att-src="'/showcase/project/' + project.project_code + '/thumbnail'"
                     t-att-alt="project.title" class="uikick-card-img"/>
                <t t-if="project.video_embed_url">
                    <!-- Video YouTube: preload src rỗng, home.js chỉ gán
                         data-src (tự phát/tắt tiếng/lặp) khi hover vào card. -->
                    <iframe t-att-data-src="project.video_preview_embed_url"
                            class="uikick-card-video-frame" title="" frameborder="0"
                            allow="autoplay; encrypted-media" tabindex="-1"/>
                </t>
                <t t-else="">
                    <video t-att-src="project.video_url" muted="muted" loop="loop"
                           playsinline="playsinline" preload="metadata"
                           class="uikick-card-video"/>
                </t>
                <t t-if="project.status_id">
                    <span class="uikick-badge">
                        <t t-esc="project.status_id.name"/>
                    </span>
                </t>
            </div>
            <div class="uikick-card-body">
                <p class="uikick-card-category">
                    <t t-esc="project.category_id.name"/>
                </p>
                <h3 class="uikick-card-title">
                    <t t-esc="project.title"/>
                </h3>
                <p t-if="project.creator_names" class="uikick-card-creator">đăng bởi
                    <span>
                        <t t-esc="project.creator_names"/>
                    </span>
                </p>


                <div t-if="project.location_id" class="uikick-card-location">
                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                              d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                    </svg>
                    <span>
                        <t t-esc="project.location_id.name"/>
                    </span>
                </div>
            </div>
        </a>
    </template>


    <template id="advisor_card" name="EAUT Showcase - Advisor Card">
        <div class="uikick-card">
            <a t-att-href="'/showcase/creator/' + str(creator.id)">
                <div class="uikick-card-media uikick-card-media-avatar">
                    <img t-if="creator.avatar"
                         t-att-src="'/showcase/creator/' + str(creator.id) + '/avatar'"
                         t-att-alt="creator.name" class="uikick-card-img"/>
                    <span t-if="remaining_slots is None" class="uikick-badge text-bg-secondary">Chưa mở đăng ký</span>
                    <span t-elif="remaining_slots &gt; 0" class="uikick-badge text-bg-success">
                        Còn
                        <t t-esc="remaining_slots"/>
                        chỗ
                    </span>
                    <span t-else="" class="uikick-badge text-bg-secondary">Đã đầy</span>
                </div>
                <div class="uikick-card-body">
                    <p class="uikick-card-category">
                        <t t-esc="', '.join(creator.category_ids.mapped('name')) or 'Chưa khai lĩnh vực'"/>
                    </p>
                    <h3 class="uikick-card-title">
                        <t t-esc="creator.name"/>
                    </h3>
                    <p t-if="creator.role" class="uikick-card-creator">
                        <span t-esc="creator.role"/>
                    </p>
                    <!--                    <p class="uikick-card-creator text-muted">-->
                    <!--                        <t t-esc="capacity.term_id.name"/>-->
                    <!--                    </p>-->
                    <!--                    <div t-if="creator.location_id" class="uikick-card-location">-->
                    <!--                        <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20">-->
                    <!--                            <path fill-rule="evenodd" clip-rule="evenodd"-->
                    <!--                                  d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>-->
                    <!--                        </svg>-->
                    <!--                        <span t-esc="creator.location_id.name"/>-->
                    <!--                    </div>-->
                </div>
            </a>
            <a t-if="remaining_slots is not None" href="/my/advisor"
               class="btn btn-primary btn-sm rounded-pill uikick-btn-block mt-2">
                Chọn làm giảng viên hướng dẫn
            </a>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- HOME PAGE (danh sách project + sidebar filter)                -->
    <!-- ============================================================ -->
    <template id="home_page" name="EAUT Showcase - Discover">
        <t t-call="web.frontend_layout">
            <t t-set="title" t-value="(header_label or '')"/>
            <div id="wrap" class="uikick">

                <div class="uikick-body">
                    <!-- Sidebar filters -->
                    <button type="button" id="uikick-filter-toggle" class="uikick-filter-toggle">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12h12M3 6h18M9 18h6"/>
                        </svg>
                        Filter by
                        <svg class="uikick-filter-toggle-chevron" width="12" height="12" fill="none"
                             stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <form method="get" action="/showcase" id="uikick-filter-form" class="uikick-sidebar">
                        <p class="uikick-sidebar-title">Lọc theo</p>
                        <input type="hidden" name="categories_submitted" value="1"/>

                        <div class="uikick-filter-group">
                            <h3>Xem theo</h3>
                            <label class="uikick-check-row uikick-check-row-single">
                                <input type="radio" name="section" value="projects"
                                       t-att-checked="'checked' if section == 'projects' else None"
                                       onchange="this.form.submit()"/>
                                Dự án
                            </label>
                            <label class="uikick-check-row uikick-check-row-single">
                                <input type="radio" name="section" value="advisors"
                                       t-att-checked="'checked' if section == 'advisors' else None"
                                       onchange="this.form.submit()"/>
                                Giảng viên hướng dẫn đồ án
                            </label>
                        </div>

                        <t t-if="section == 'advisors'">
                            <hr/>
                            <div class="uikick-filter-group">
                                <h3>Kỳ đồ án</h3>
                                <t t-foreach="open_terms" t-as="term_opt">
                                    <label class="uikick-check-row uikick-check-row-single">
                                        <input type="checkbox" name="term" t-att-value="term_opt.id"
                                               t-att-checked="'checked' if term_opt.id in filters['term'] else None"/>
                                        <t t-esc="term_opt.name"/>
                                    </label>
                                </t>
                                <p t-if="not open_terms" class="text-muted small mb-0">
                                    Hiện không có kỳ nào đang mở.
                                </p>
                            </div>
                            <hr/>
                            <div class="uikick-filter-group">
                                <h3>Khoa</h3>
                                <t t-foreach="departments" t-as="dept">
                                    <label class="uikick-check-row uikick-check-row-single">
                                        <input type="checkbox" name="department" t-att-value="dept.id"
                                               t-att-checked="'checked' if dept.id in filters['department'] else None"/>
                                        <t t-esc="dept.name"/>
                                    </label>
                                </t>
                                <p t-if="not departments" class="text-muted small mb-0">
                                    Chưa có khoa nào được khai báo.
                                </p>
                            </div>
                        </t>

                        <hr/>

                        <div class="uikick-filter-group">
                            <h3>Danh mục</h3>
                            <div class="uikick-category-list">
                                <t t-foreach="categories" t-as="cat">
                                    <label class="uikick-check-row uikick-cat-check-row">
                                        <span>
                                            <input type="checkbox" name="category" t-att-value="cat.name"
                                                   t-att-checked="'checked' if cat.name in filters['categories'] else None"/>
                                            <t t-esc="cat.name"/>
                                        </span>
                                    </label>
                                </t>
                            </div>
                        </div>

                        <hr/>

                        <div class="uikick-filter-group">
                            <h3>
                                <t t-esc="'Trạng thái dự án' if section == 'projects' else 'Trạng thái nhận SV'"/>
                            </h3>
                            <t t-if="section == 'projects'">
                                <t t-foreach="all_statuses" t-as="st">
                                    <label class="uikick-check-row uikick-check-row-single">
                                        <input type="checkbox" name="status" t-att-value="st.name"
                                               t-att-checked="'checked' if st.name in filters['status'] else None"/>
                                        <t t-esc="st.name"/>
                                    </label>
                                </t>
                            </t>
                            <t t-else="">
                                <label class="uikick-check-row uikick-check-row-single">
                                    <input type="checkbox" name="status" value="open"
                                           t-att-checked="'checked' if 'open' in filters['status'] else None"/>
                                    Còn nhận
                                </label>

                                <label class="uikick-check-row uikick-check-row-single">
                                    <input type="checkbox" name="status" value="full"
                                           t-att-checked="'checked' if 'full' in filters['status'] else None"/>
                                    Đã đầy
                                </label>
                            </t>
                        </div>

                        <t t-if="section == 'projects'">
                            <hr/>
                            <div class="uikick-filter-group">
                                <h3>Địa điểm</h3>
                                <input type="text" name="location" placeholder="Tìm kiếm theo thành phố, tỉnh..."
                                       class="uikick-input" id="uikick-location-input"
                                       t-att-value="filters['location']"/>
                                <select class="uikick-select" id="uikick-location-select">
                                    <option value="">Tất cả địa điểm</option>
                                    <t t-foreach="all_locations" t-as="loc">
                                        <option t-att-value="loc.name"
                                                t-att-selected="'selected' if filters['location'] == loc.name else None">
                                            <t t-esc="loc.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </t>

                        <button type="submit"
                                class="btn btn-primary btn-sm rounded-pill uikick-btn-block uikick-filter-apply">Áp dụng
                        </button>
                    </form>

                    <!-- Main content -->
                    <main class="uikick-main">
                        <div class="uikick-main-header">
                            <div>
                                <h1>
                                    <t t-esc="header_label"/>
                                </h1>
                                <p>
                                    <t t-esc="items_count"/>
                                    <t t-esc="' ' + items_label"/>
                                </p>
                            </div>
                            <div class="uikick-sort">
                                <span>Sắp xếp theo</span>
                                <select class="uikick-select" id="uikick-sort-select" name="sort"
                                        form="uikick-filter-form">
                                    <t t-foreach="sort_options" t-as="opt">
                                        <option t-att-value="opt"
                                                t-att-selected="'selected' if filters['sort'] == opt else None">
                                            <t t-esc="sort_labels.get(opt, opt)"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="uikick-grid">
                            <t t-if="section == 'projects'">
                                <t t-foreach="projects" t-as="project">
                                    <t t-call="eaut_showcase.project_card"/>
                                </t>
                                <t t-if="not projects">
                                    <p class="uikick-empty">Không có dự án nào phù hợp với các bộ lọc này.</p>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="capacities" t-as="item">
                                    <t t-set="creator" t-value="item['creator']"/>
                                    <t t-set="remaining_slots" t-value="item['remaining_slots']"/>
                                    <t t-call="eaut_showcase.advisor_card"/>
                                </t>
                                <t t-if="not capacities">
                                    <p class="uikick-empty">
                                        <t t-if="not open_terms">Hiện không có kỳ đồ án nào đang mở đăng ký chọn giảng
                                            viên hướng dẫn.
                                        </t>
                                        <t t-else="">Không có giảng viên nào phù hợp với các bộ lọc này.</t>
                                    </p>
                                </t>
                            </t>
                        </div>
                        <t t-if="pager['page_count'] &gt; 1">
                            <div class="uikick-pager">
                                <t t-call="website.pager"/>
                            </div>
                        </t>
                    </main>
                </div>
            </div>
        </t>
    </template>

</odoo>