<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_showcase_interest_list" model="ir.ui.view">
        <field name="name">eaut_showcase.interest.list</field>
        <field name="model">eaut_showcase.interest</field>
        <field name="arch" type="xml">
            <list string="Người quan tâm" decoration-muted="state == 'closed'">
                <field name="create_date" string="Ngày gửi"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="project_id"/>
                  <field name="public_display" widget="boolean_toggle" string="Công khai"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-success="state == 'contacted'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_showcase_interest_form" model="ir.ui.view">
        <field name="name">eaut_showcase.interest.form</field>
        <field name="model">eaut_showcase.interest</field>
        <field name="arch" type="xml">
            <form string="Người quan tâm">
                <sheet>
                    <widget name="web_ribbon" title="Đã đóng" bg_color="text-bg-secondary"
                            invisible="state != 'closed'"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Họ tên"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="state" widget="radio"/>
                               <field name="public_display"/>
                        </group>
                    </group>
                    <group string="Lời nhắn">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eaut_showcase_interest_search" model="ir.ui.view">
        <field name="name">eaut_showcase.interest.search</field>
        <field name="model">eaut_showcase.interest</field>
        <field name="arch" type="xml">
            <search string="Tìm người quan tâm">
                <field name="name"/>
                <field name="email"/>
                <field name="project_id"/>
                <filter name="new" string="Mới" domain="[('state', '=', 'new')]"/>
                <filter name="contacted" string="Đã liên hệ" domain="[('state', '=', 'contacted')]"/>
                <group>
                    <filter name="group_by_project" string="Dự án" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eaut_showcase_interest" model="ir.actions.act_window">
        <field name="name">Người quan tâm</field>
        <field name="res_model">eaut_showcase.interest</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có ai điền form quan tâm dự án nào cả.
            </p>
        </field>
    </record>

</odoo>