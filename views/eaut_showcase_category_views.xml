<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_showcase_category_list" model="ir.ui.view">
        <field name="name">eaut_showcase.category.list</field>
        <field name="model">eaut_showcase.category</field>
        <field name="arch" type="xml">
            <list string="Danh mục" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_eaut_showcase_category" model="ir.actions.act_window">
        <field name="name">Danh mục</field>
        <field name="res_model">eaut_showcase.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo danh mục (VD: Art, Dance...) để phân loại dự án
            </p>
        </field>
    </record>

</odoo>