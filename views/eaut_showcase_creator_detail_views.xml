<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- CREATOR PROFILE PAGE (trang công khai của 1 tác giả)          -->
    <!-- ============================================================ -->
    <template id="creator_detail_page" name="UIKick - Creator Profile">
        <t t-call="web.frontend_layout">
            <t t-set="title" t-value="(creator.name or '') + ' — Kickstarter'"/>
            <div id="wrap" class="uikick uikick-creator-page">
                <!-- Breadcrumb -->
                <nav class="uikick-breadcrumb">
                    <div class="uikick-container">
                        <a href="/showcase">Khám phá</a>
                        <span class="uikick-breadcrumb-sep">›</span>
                        <span>Tác giả</span>
                        <span class="uikick-breadcrumb-sep">›</span>
                        <span class="uikick-breadcrumb-current">
                            <t t-esc="creator.name"/>
                        </span>
                    </div>
                </nav>
                <div class="uikick-creator-page-hero">
                    <div class="uikick-creator-page-avatar">
                        <t t-if="creator.avatar">
                            <img t-attf-src="/showcase/creator/#{creator.id}/avatar" t-att-alt="creator.name"/>
                        </t>
                        <t t-else="">
                            <t t-esc="(creator.name or '')[:1]"/>
                        </t>
                    </div>
                    <h1 class="uikick-creator-page-name">
                        <t t-esc="creator.name"/>
                    </h1>
                    <p class="uikick-creator-page-role" t-if="creator.role">
                        <t t-esc="creator.role"/>
                    </p>
                    <p class="uikick-creator-page-meta">
                        <span>
                            <t t-esc="creator.project_count"/>
                            dự án đã đăng
                        </span>
                        <t t-if="creator.location_id">
                            <span>•</span>
                            <span>
                                <t t-esc="creator.location_id.name"/>
                            </span>
                        </t>
                    </p>
                </div>

                <div class="uikick-creator-page-tabs-row">
                    <div class="uikick-container">
                        <nav class="uikick-tabs" id="uikick-tabs">
                            <a href="#" data-tab="About" class="uikick-tab active">Giới thiệu</a>
                            <a href="#" data-tab="Created" class="uikick-tab">
                                Dự án đã đăng
                                <span class="uikick-tab-count">
                                    <t t-esc="len(projects)"/>
                                </span>
                            </a>
                        </nav>
                    </div>
                </div>

                <div class="uikick-container uikick-creator-page-body">
                    <div class="uikick-tab-content active" data-tab="About">
                        <div class="uikick-creator-about">
                            <div class="uikick-creator-about-label">Giới thiệu</div>
                            <div class="uikick-creator-about-text">
                                <t t-if="creator.bio">
                                    <t t-esc="creator.bio"/>
                                </t>
                                <t t-else="">Tác giả chưa cập nhật phần giới thiệu.</t>
                            </div>
                        </div>
                        <div class="uikick-creator-about" t-if="creator.email">
                            <div class="uikick-creator-about-label">Email</div>
                            <div class="uikick-creator-about-text">
                                <a t-attf-href="mailto:#{creator.email}">
                                    <t t-esc="creator.email"/>
                                </a>
                            </div>
                        </div>
                        <div class="uikick-creator-about" t-if="creator.website_url">
                            <div class="uikick-creator-about-label">Website</div>
                            <div class="uikick-creator-about-text">
                                <a t-att-href="creator.website_url" target="_blank" rel="noopener">
                                    <t t-esc="creator.website_url"/>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="uikick-tab-content" data-tab="Created">
                        <div class="uikick-grid">
                            <t t-foreach="projects" t-as="project">
                                <t t-call="eaut_showcase.project_card"/>
                            </t>
                            <t t-if="not projects">
                                <p class="uikick-empty">Tác giả này chưa đăng dự án nào.</p>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>