<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_showcase_advisor_registration_search" model="ir.ui.view">
        <field name="name">eaut_showcase.advisor.registration.search</field>
        <field name="model">eaut_showcase.advisor.registration</field>
        <field name="arch" type="xml">
            <search string="Tìm hồ sơ đăng ký">
                <field name="student_id"/>
                <field name="assigned_creator_id"/>
                <field name="term_id"/>
                <filter name="unassigned" string="Chưa gán"
                        domain="[('state', '=', 'unassigned')]"/>
                <group>
                    <filter name="group_by_term" string="Kỳ đồ án" context="{'group_by': 'term_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eaut_showcase_advisor_registration_kanban" model="ir.ui.view">
        <field name="name">eaut_showcase.advisor.registration.kanban</field>
        <field name="model">eaut_showcase.advisor.registration</field>
        <field name="arch" type="xml">
            <kanban default_group_by="assigned_creator_id" records_draggable="true"
                    group_create="false" group_delete="false" quick_create="false">
                <field name="student_id"/>
                <field name="state"/>
                <field name="assigned_creator_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_card oe_kanban_card
                                            #{record.state.raw_value === 'approved' ? 'border-success' :
                                              record.state.raw_value === 'unassigned' ? 'border-danger' :
                                              'border-warning'}">
                            <div class="o_kanban_record_top">
                                <strong><field name="student_id"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <span t-if="record.state.raw_value === 'approved'"
                                      class="badge text-bg-success">Đã duyệt</span>
                                <span t-elif="record.state.raw_value === 'in_progress'"
                                      class="badge text-bg-warning">Đang chờ duyệt</span>
                                <span t-elif="record.state.raw_value === 'unassigned'"
                                      class="badge text-bg-danger">Chưa gán</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_eaut_showcase_advisor_registration_kanban" model="ir.actions.act_window">
        <field name="name">Phân bổ giảng viên hướng dẫn</field>
        <field name="res_model">eaut_showcase.advisor.registration</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '!=', 'draft')]</field>
        <field name="context">{'search_default_unassigned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có sinh viên nào cần xử lý.
            </p>
        </field>
    </record>

</odoo>
