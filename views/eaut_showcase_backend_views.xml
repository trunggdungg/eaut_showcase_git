<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- eaut_showcase.project backend views                                  -->
    <!-- ============================================================ -->
    <record id="view_uikick_project_list" model="ir.ui.view">
        <field name="name">eaut_showcase.project.list</field>
        <field name="model">eaut_showcase.project</field>
        <field name="arch" type="xml">
            <list string="Dự án EAUT Showcase">
                <field name="sequence" widget="handle" string="Thứ tự"/>
                <field name="title" string="Tiêu đề"/>
                <field name="category_id" string="Danh mục"/>
                <field name="status_id" widget="badge" string="Trạng thái"/>
                <field name="views" string="Lượt xem"/>
                <field name="interest_count" string="Lượt quan tâm"/>
                <field name="active" string="Hoạt động" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_uikick_project_form" model="ir.ui.view">
        <field name="name">eaut_showcase.project.form</field>
        <field name="model">eaut_showcase.project</field>
        <field name="arch" type="xml">
            <form string="Dự án EAUT Showcase">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_interests"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="interest_count"
                                   widget="statinfo"
                                   string="Quan tâm"/>
                        </button>
                        <button name="action_view_comments" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <field name="comment_count" widget="statinfo" string="Bình luận"/>
                        </button>
                    </div>

                    <field name="image"
                           widget="image"
                           class="oe_avatar"
                           string="Ảnh dự án"/>

                    <div class="oe_title">
                        <label for="title" string="Tiêu đề"/>
                        <h1>
                            <field name="title"
                                   string="Tiêu đề"
                                   placeholder="Nhập tiêu đề dự án..."/>
                        </h1>

                        <field name="subtitle"
                               string="Phụ đề"
                               placeholder="Phụ đề bài đăng..."/>
                    </div>

                    <group>
                        <group>
                            <field name="creator_ids"
                                   widget="many2many_tags"
                                   string="Tác giả"/>

                            <field name="category_id"
                                   string="Danh mục"/>

                            <field name="status_id"
                                   string="Trạng thái"/>

                            <field name="location_id"
                                   string="Địa điểm"/>

                            <field name="active"
                                   string="Hoạt động"/>
                        </group>

                        <group>
                            <field name="views"
                                   string="Lượt xem"/>

                            <field name="sequence"
                                   string="Thứ tự"/>
                        </group>
                    </group>

                    <group string="Media">
                        <field name="video_url"
                               string="Đường dẫn video"/>
                    </group>

                    <notebook>
                        <page string="Mô tả giới thiệu" name="description">
                            <field name="description"
                                   widget="html"
                                   nolabel="1"
                                   string="Mô tả giới thiệu"
                                   style="width: 100%;"/>
                        </page>

                        <!--                        <page string="Thống kê" name="stats">-->
                        <!--                            <field name="campaign_number"-->
                        <!--                                   string="Số liệu chiến dịch"/>-->
                        <!--                        </page>-->

                        <page string="FAQ" name="faq">
                            <field name="faq_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question"/>
                                    <field name="answer"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_uikick_project" model="ir.actions.act_window">
        <field name="name">Dự án</field>
        <field name="res_model">eaut_showcase.project</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ============================================================ -->
    <!-- Menu                                                          -->
    <!-- ============================================================ -->
    <menuitem id="menu_uikick_root" name="Eaut Showcase" sequence="100"
              web_icon="eaut_showcase,static/description/icon.png"/>

    <menuitem id="menu_uikick_creator" name="Tác giả" parent="menu_uikick_root"
              action="action_eaut_showcase_creator" sequence="10"/>

    <menuitem id="menu_uikick_category" name="Danh mục" parent="menu_uikick_root"
              action="action_eaut_showcase_category" sequence="20"/>

    <!--    Cấu hình dự án-->
    <menuitem id="menu_uikick_project_config" name="Cấu hình dự án" parent="menu_uikick_root" sequence="30"/>

    <menuitem id="menu_uikick_projects" name="Dự án" parent="menu_uikick_project_config"
              action="action_uikick_project" sequence="10"/>

    <menuitem id="menu_uikick_interest" name="Người quan tâm" parent="menu_uikick_project_config"
              action="action_eaut_showcase_interest" sequence="20"/>

    <menuitem id="menu_uikick_comment" name="Bình luận" parent="menu_uikick_project_config"
              action="action_eaut_showcase_comment" sequence="30"/>

    <menuitem id="menu_uikick_status" name="Trạng thái" parent="menu_uikick_project_config"
              action="action_eaut_showcase_status" sequence="40"/>
    <!--    End Cấu hình dự án-->

    <!--    Cấu hình đồ án-->
    <menuitem id="menu_uikick_thesis_config" name="Cấu hình đồ án" parent="menu_uikick_root" sequence="40"/>

    <menuitem id="menu_uikick_term" name="Kỳ đồ án" parent="menu_uikick_thesis_config"
              action="action_eaut_showcase_term" sequence="10"/>

    <menuitem id="menu_uikick_advisor_registration" name="Đăng ký chọn GVHD" parent="menu_uikick_thesis_config"
              action="action_eaut_showcase_advisor_registration" sequence="20"/>

    <menuitem id="menu_uikick_advisor_registration_kanban" name="Phân bổ giảng viên" parent="menu_uikick_thesis_config"
              action="action_eaut_showcase_advisor_registration_kanban" sequence="30"/>

    <menuitem id="menu_uikick_creator_kanban" name="Phân bổ giảng viên theo kỳ" parent="menu_uikick_thesis_config"
              action="action_eaut_showcase_creator_kanban" sequence="40"/>
    <!--    End Cấu hình đồ án-->

</odoo>