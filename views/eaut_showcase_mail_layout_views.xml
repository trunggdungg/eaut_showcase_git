<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- KHUNG EMAIL RIÊNG cho các thông báo nguyện vọng GVHD           -->
    <!-- ============================================================ -->
    <!-- Thay khung mặc định của Odoo (nút "Xem hồ sơ..." tự sinh, chữ ký
         Administrator) bằng 1 khung có thanh tên trường và footer riêng,
         dùng qua tham số email_layout_xmlid khi gọi message_post() trong
         models/eaut_showcase_advisor_registration.py. Chỉ đọc duy nhất
         message.body (đã sanitize sẵn bởi Odoo), không phụ thuộc các biến
         phụ (button_access, tracking_values, signature) của layout mặc
         định, để tránh vỡ khi lên đời Odoo. -->
    <template id="mail_layout_advisor_notification"
              name="EAUT Showcase - Khung email thông báo nguyện vọng GVHD">
        <div style="font-family:'Segoe UI',Helvetica,Arial,sans-serif;max-width:480px;margin:0 auto;border:1px solid #e2e2e2;border-radius:8px;overflow:hidden;">
            <div style="background:#7b3f61;color:#ffffff;padding:16px 20px;font-weight:600;font-size:16px;">
                EAUT Showcase — Hệ thống chọn giảng viên hướng dẫn
            </div>
            <div style="padding:20px;background:#ffffff;">
                <t t-out="message.body"/>
            </div>
            <div style="background:#f5f5f5;color:#888888;padding:12px 20px;font-size:12px;">
                Email tự động từ hệ thống EAUT Showcase — vui lòng không phản hồi trực tiếp email này.
            </div>
        </div>
    </template>

</odoo>