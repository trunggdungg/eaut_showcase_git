<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_advisor" name="Portal My Home - Chọn/Quản lý GVHD"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-set="eaut_showcase_lecturer"
               t-value="request.env['eaut_showcase.creator'].sudo().search([('user_id', '=', request.env.uid)], limit=1)"/>
            <t t-if="eaut_showcase_lecturer">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Quản lý sinh viên hướng dẫn</t>
                    <t t-set="text">Duyệt các yêu cầu hướng dẫn đồ án từ sinh viên</t>
                    <t t-set="url" t-value="'/my/advisor-requests'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
            <t t-else="">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Chọn giảng viên hướng dẫn đồ án</t>
                    <t t-set="text">Đăng ký nguyện vọng chọn giảng viên hướng dẫn</t>
                    <t t-set="url" t-value="'/my/advisor'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
        </xpath>
    </template>

</odoo>
