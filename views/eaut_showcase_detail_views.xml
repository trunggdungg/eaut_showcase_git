<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- ============================================================ -->
    <!-- DETAIL PAGE (chi tiết chiến dịch)                             -->
    <!-- ============================================================ -->
    <template id="detail_page" name="UIKick - Campaign Detail">
        <t t-call="web.frontend_layout">
            <t t-set="title" t-value="(project.title or '') + ' — Kickstarter'"/>
            <div id="wrap" class="uikick uikick-detail">

                <!-- Breadcrumb -->
                <nav class="uikick-breadcrumb">
                    <div class="uikick-container">
                        <a href="/showcase">Khám phá</a>
                        <span class="uikick-breadcrumb-sep">›</span>
                        <a t-att-href="'/showcase/category/' + (project.category_id.name or '')">
                            <t t-esc="project.category_id.name"/>
                        </a>
                        <span class="uikick-breadcrumb-sep">›</span>
                        <span class="uikick-breadcrumb-current">
                            <t t-esc="project.title"/>
                        </span>
                    </div>
                </nav>

                <!-- Hero title -->
                <div class="uikick-detail-hero">
                    <div class="uikick-container">
                        <h1>
                            <t t-esc="project.title"/>
                        </h1>
                        <p t-if="project.subtitle" class="uikick-detail-desc">
                            <t t-esc="project.subtitle"/>
                        </p>
                    </div>
                </div>

                <!-- Hero media: video (left) + pledge sidebar (right), matching real Kickstarter campaign pages -->
                <div class="uikick-hero-media">
                    <div class="uikick-container uikick-hero-row">
                        <div class="uikick-hero-video-col">
                            <div class="uikick-hero-video" id="uikick-hero-video">
                                <t t-if="project.video_embed_url">
                                    <!-- Link chia sẻ YouTube: không thể phát bằng thẻ video, nhúng iframe player
                                         chính chủ (đã có sẵn thumbnail + nút play + thanh điều khiển riêng). -->
                                    <iframe t-att-src="project.video_embed_url" class="uikick-hero-video-iframe"
                                            title="Video giới thiệu" frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            allowfullscreen="allowfullscreen" loading="lazy"/>
                                </t>
                                <t t-else="">
                                    <img t-att-src="'/showcase/project/' + (project.project_code or '') + '/thumbnail'"
                                         t-att-alt="project.title" class="uikick-hero-video-img"/>
                                    <video t-att-src="project.video_url" loop="loop" playsinline="playsinline"
                                           controls="controls" preload="auto" class="uikick-hero-video-el"/>
                                    <div class="uikick-hero-play-overlay">
                                        <div class="uikick-hero-play-circle">
                                            <svg width="20" height="20" fill="white" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z"/>
                                            </svg>
                                        </div>
                                    </div>

                                    <div class="uikick-hero-pause-overlay">
                                        <svg width="14" height="14" fill="white" viewBox="0 0 24 24">
                                            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                                        </svg>
                                    </div>
                                </t>
                                <!--                                <div class="uikick-hero-pause-overlay">-->
                                <!--                                    <svg width="14" height="14" fill="white" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>-->
                                <!--                                </div>-->
                                <!--                                <div class="uikick-hero-text-overlay">-->
                                <!--                                    <t t-if="project.campaign_number">-->
                                <!--                                        <div class="uikick-hero-campaign-num">-->
                                <!--                                            SẢN PHẨM THỨ <t t-esc="str(project.campaign_number)"/>.-->
                                <!--                                        </div>-->
                                <!--                                    </t>-->
                                <!--                                    <div class="uikick-hero-total">-->
                                <!--                                         <t t-esc="'{:,}'.format(project.views or 0).replace(',', '.')"/> lượt xem bài đăng này.-->
                                <!--                                    </div>-->
                                <!--                                </div>-->
                            </div>
                            <div class="uikick-hero-tags">
                                <span class="uikick-hero-tag">
                                    <svg width="14" height="14" fill="none" stroke="#05ce78" stroke-width="1.5"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
                                    </svg>
                                    Sản phẩm nổi bật
                                </span>
<!--                                <span class="uikick-hero-tag">-->
<!--                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"-->
<!--                                         viewBox="0 0 24 24">-->
<!--                                        <path stroke-linecap="round" stroke-linejoin="round"-->
<!--                                              d="M9 20l-5.447 2.724A1 1 0 013 21.882V6.618a1 1 0 01.553-.894L9 3m0 17l6 3m-6-3V3m6 17l5.447 2.724A1 1 0 0021 21.882V6.618a1 1 0 00-.553-.894L15 3m0 17V3m0 0L9 3"/>-->
<!--                                    </svg>-->
<!--                                    <t t-esc="project.category_id.name"/>-->
<!--                                </span>-->
<!--                                <span class="uikick-hero-tag">-->
<!--                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">-->
<!--                                        <path fill-rule="evenodd" clip-rule="evenodd"-->
<!--                                              d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>-->
<!--                                    </svg>-->
<!--                                    <t t-esc="project.location_id.name"/>-->
<!--                                </span>-->
                            </div>
                        </div>

                        <aside class="uikick-hero-pledge">
                            <div class="uikick-interest-accent"/>
                            <div class="uikick-interest-count">
                                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <span>
                                    <t t-esc="'{:,}'.format(project.views or 0).replace(',', '.')"/>
                                </span>
                            </div>
                            <p class="uikick-interest-label">lượt xem bài đăng</p>

                            <div class="uikick-hero-meta-group">
                                <h4>Danh mục</h4>
                                  <t t-if="project.category_id">
                                    <span class="uikick-category-badge"
                                          t-att-style="('background-color: %s; color: #fff;' % project.category_id.color_hex) if project.category_id.color_hex else None">
                                        <t t-esc="project.category_id.name"/>
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="uikick-category-badge uikick-category-badge-empty">Chưa có danh mục</span>
                                </t>
                            </div>
                             <div class="uikick-hero-meta-group">
                                <h4>Địa điểm</h4>
                                <t t-if="project.location_id">
                                    <div class="uikick-hero-location">
                                        <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" clip-rule="evenodd"
                                                  d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                        </svg>
                                        <t t-esc="project.location_id.name"/>
                                    </div>

                                </t>
                                <t t-else="">
                                    <span class="uikick-category-badge uikick-category-badge-empty">Chưa có địa điểm</span>
                                </t>
                            </div>

<!--                            <button class="btn btn-primary btn-sm rounded-pill uikick-btn-block">-->
<!--                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"-->
<!--                                     viewBox="0 0 24 24">-->
<!--                                    <path stroke-linecap="round" stroke-linejoin="round"-->
<!--                                          d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>-->
<!--                                </svg>-->
<!--                                Quan tâm ngay-->
<!--                            </button>-->
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm uikick-btn-outline uikick-btn-block uikick-remind-btn">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                <span class="uikick-remind-label">Để lại thông tin</span>
                            </button>
                            <p class="uikick-interest-help">Nhấn "Để lại thông tin" để theo dõi sản phẩm và nhận thông báo khi
                                có cập nhật mới.
                            </p>
                        </aside>
                    </div>
                </div>

                <!-- Platform info banner -->
                <div class="uikick-info-banner">
                    <div class="uikick-container uikick-info-grid">
                        <div class="uikick-info-item">
                            <div class="uikick-info-icon">
                                 <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M9 20l-5.447 2.724A1 1 0 013 21.882V6.618a1 1 0 01.553-.894L9 3m0 17l6 3m-6-3V3m6 17l5.447 2.724A1 1 0 0021 21.882V6.618a1 1 0 00-.553-.894L15 3m0 17V3m0 0L9 3"/>
                                    </svg>
                            </div>
                            <p>Khám phá các sản phẩm sáng tạo từ khắp nơi trên thế giới.</p>
                        </div>
                        <div class="uikick-info-item">
                            <div class="uikick-info-icon">
                                <svg width="12" height="12" fill="none" stroke="#666" stroke-width="2"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
                                </svg>
                            </div>
                            <p>Nhận thông báo cập nhật mới nhất từ tác giả khi bạn quan tâm sản phẩm.</p>
                        </div>
                        <div class="uikick-info-item">
                            <div class="uikick-info-icon">
                                <svg width="12" height="12" fill="none" stroke="#666" stroke-width="2"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <p>Kết nối trực tiếp với tác giả và cộng đồng yêu thích sản phẩm.</p>
                        </div>
                    </div>
                </div>

                <div class="uikick-container uikick-detail-body">
                    <!-- Tabs -->
                    <div class="uikick-tabs-row">
                        <nav class="uikick-tabs" id="uikick-tabs">
                            <t t-foreach="tabs" t-as="tab">
                                <a href="#" t-att-data-tab="tab"
                                   t-att-class="'uikick-tab active' if tab_index == 0 else 'uikick-tab'">
                                    <t t-esc="tab_labels.get(tab, tab)"/>
                                      <t t-if="tab == 'Comments'"><span class="uikick-tab-count"><t t-esc="len(approved_comments)"/></span></t>
                                </a>
                            </t>
                        </nav>
                        <div class="uikick-tabs-actions">
<!--                            <button class="btn btn-primary btn-sm rounded-pill">Quan tâm ngay</button>-->
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm uikick-btn-outline uikick-remind-btn">
                                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                <span class="uikick-remind-label">Để lại thông tin</span>
                            </button>
                        </div>
                    </div>

                    <div class="uikick-detail-columns">
                        <!-- Left: mục lục tự sinh từ các tiêu đề H2 trong "Mô tả giới thiệu" -->
                        <aside class="uikick-toc-sidebar" id="uikick-toc-sidebar">
                            <nav id="uikick-toc-nav"/>
                        </aside>

                        <!-- Center: tab content -->
                        <main class="uikick-detail-main">
                            <div class="uikick-tab-content active" data-tab="Campaign">
                                <div class="uikick-story-text" id="uikick-description-content"
                                     t-field="project.description"/>

                                 <div t-if="submitted and already_interested" class="alert alert-success mt-4">
                                    Bạn đã quan tâm dự án này trước đó — thông tin của bạn đã được cập nhật.
                                </div>
                                <div t-elif="submitted" class="alert alert-success mt-4">
                                    Cảm ơn bạn đã quan tâm! Chúng tôi sẽ liên hệ sớm.
                                </div>
                                <div t-if="error" class="alert alert-danger mt-4" t-out="error"/>

                                <form class="uikick-lead-form"
                                      t-att-action="'/showcase/project/' + (project.project_code or '') + '/interest'"
                                      method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <h3>
                                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"
                                             viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
                                        </svg>
                                        Để lại thông tin quan tâm
                                    </h3>
                                    <p class="uikick-lead-form-desc">Chúng tôi sẽ liên hệ với bạn ngay khi sản phẩm có
                                        thông tin mới nhất.
                                    </p>
                                    <div class="uikick-lead-form-row">
                                        <div class="uikick-lead-field">
                                            <label>Họ và tên
                                                <span class="uikick-required">*</span>
                                            </label>
                                            <input type="text" name="lead_name" placeholder="Nguyễn Văn A"
                                                   required="required"/>
                                        </div>
                                        <div class="uikick-lead-field">
                                            <label>Số điện thoại</label>
                                            <input type="tel" name="lead_phone" placeholder="0912 345 678"/>
                                        </div>
                                    </div>
                                    <div class="uikick-lead-field">
                                        <label>Email
                                            <span class="uikick-required">*</span>
                                        </label>
                                        <input type="email" name="lead_email" placeholder="example@email.com"
                                               required="required"/>
                                    </div>
                                    <div class="uikick-lead-field">
                                        <label>Ghi chú / Câu hỏi</label>
                                        <textarea name="lead_note" placeholder="Tôi quan tâm đến sản phẩm này vì..."/>
                                    </div>
                                     <label class="uikick-lead-checkbox">
                                        <input type="checkbox" name="public_display" value="1"/>
                                        Đồng ý hiển thị tên của tôi công khai ở tab Cộng đồng
                                    </label>
                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill uikick-btn-block">
                                        Gửi thông tin
                                    </button>
                                    <p class="uikick-lead-form-note">Thông tin của bạn được bảo mật và chỉ dùng để liên
                                        hệ về sản phẩm này.
                                    </p>
                                </form>
                            </div>


                            <t t-foreach="tabs" t-as="tab">
                                 <t t-if="tab == 'FAQ'">
                                    <div class="uikick-tab-content" t-att-data-tab="tab">
                                        <t t-if="project.faq_ids">
                                            <div class="uikick-faq-list">
                                                <t t-foreach="project.faq_ids" t-as="faq">
                                                    <div class="uikick-faq-item">
                                                        <button type="button" class="uikick-faq-question">
                                                            <span><t t-esc="faq.question"/></span>
                                                            <svg class="uikick-faq-chevron" width="16" height="16" fill="none"
                                                                 stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                                                            </svg>
                                                        </button>
                                                        <div class="uikick-faq-answer">
                                                            <p><t t-esc="faq.answer"/></p>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="uikick-tab-placeholder">
                                                <div class="uikick-tab-placeholder-icon">📋</div>
                                                <p>Chưa có câu hỏi thường gặp nào cho sản phẩm này.</p>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                    <t t-elif="tab == 'Comments'">
                                    <div class="uikick-tab-content" t-att-data-tab="tab">
                                        <div t-if="comment_submitted" class="alert alert-success mt-4">
                                            Cảm ơn bạn đã bình luận! Bình luận sẽ hiển thị sau khi được duyệt.
                                        </div>
                                        <div t-if="comment_error" class="alert alert-danger mt-4" t-out="comment_error"/>

                                        <t t-if="approved_comments">
                                            <div class="uikick-comment-list">
                                                <t t-foreach="approved_comments" t-as="cmt">
                                                    <div class="uikick-comment-item">
                                                        <div class="uikick-comment-avatar"><t t-esc="(cmt['name'] or '')[:1]"/></div>
                                                        <div class="uikick-comment-body">
                                                            <div class="uikick-comment-head">
                                                                <span class="uikick-comment-name"><t t-esc="cmt['name']"/></span>
                                                                <span class="uikick-comment-time"><t t-esc="cmt['time_ago']"/></span>
                                                            </div>
                                                            <p class="uikick-comment-content"><t t-esc="cmt['content']"/></p>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="uikick-tab-placeholder">
                                                <div class="uikick-tab-placeholder-icon">📋</div>
                                                <p>Chưa có bình luận nào cho sản phẩm này.</p>
                                            </div>
                                        </t>

                                        <form class="uikick-lead-form" id="uikick-comment-form"
                                              t-att-action="'/showcase/project/' + (project.project_code or '') + '/comment'"
                                              method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <h3>Viết bình luận</h3>
                                            <p class="uikick-lead-form-desc">Bình luận của bạn sẽ hiển thị sau khi được quản trị viên duyệt.</p>
                                            <div class="uikick-lead-field">
                                                <label>Họ và tên <span class="uikick-required">*</span></label>
                                                <input type="text" name="comment_name" placeholder="Nguyễn Văn A" required="required"/>
                                            </div>
                                            <div class="uikick-lead-field">
                                                <label>Nội dung bình luận <span class="uikick-required">*</span></label>
                                                <textarea name="comment_content" placeholder="Chia sẻ suy nghĩ của bạn về sản phẩm này..." required="required"/>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-sm rounded-pill uikick-btn-block">Gửi bình luận</button>
                                        </form>
                                    </div>
                                </t>
                                       <t t-elif="tab == 'Community'">
                                    <div class="uikick-tab-content" t-att-data-tab="tab">
                                        <p class="uikick-community-total">
                                            <t t-esc="project.interest_count"/> người đang quan tâm sản phẩm này.
                                        </p>
                                         <p t-if="anonymous_interest_count &gt; 0" class="uikick-community-anonymous-note">
                                            <t t-esc="anonymous_interest_count"/> người ẩn danh đang quan tâm.
                                        </p>
                                        <t t-if="community_members">
                                            <div class="uikick-community-list">
                                                <t t-foreach="community_members" t-as="member">
                                                    <div class="uikick-community-item">
                                                        <div class="uikick-community-avatar"><t t-esc="(member['name'] or '')[:1]"/></div>
                                                        <div>
                                                            <div class="uikick-community-name"><t t-esc="member['name']"/></div>
                                                            <div class="uikick-community-time"><t t-esc="member['time_ago']"/></div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="uikick-tab-placeholder">
                                                <div class="uikick-tab-placeholder-icon">📋</div>
                                                <p>Chưa có ai đồng ý hiển thị công khai trong cộng đồng.</p>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-elif="tab != 'Campaign'">
                                    <div class="uikick-tab-content" t-att-data-tab="tab">
                                        <div class="uikick-tab-placeholder">
                                            <div class="uikick-tab-placeholder-icon">📋</div>
                                            <p>Nội dung
                                                <t t-esc="tab_labels.get(tab, tab)"/>
                                                đang được cập nhật.
                                            </p>
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </main>

                        <!-- Right: creator + share -->
                        <aside class="uikick-detail-side">
                            <t t-foreach="project.creator_ids" t-as="creator">
                                <div class="uikick-creator-card">
                                    <div class="uikick-creator-head">

                                        <a t-attf-href="/showcase/creator/#{creator.id}"
                                           class="uikick-creator-avatar-link">

                                            <t t-if="creator.avatar">
                                                <img t-attf-src="/showcase/creator/#{creator.id}/avatar"
                                                     t-att-alt="creator.name"
                                                     class="uikick-creator-avatar"/>
                                            </t>

                                            <t t-else="">
                                                <div class="uikick-creator-avatar uikick-creator-avatar-default">
                                                    <t t-esc="creator.name[:1]"/>
                                                </div>
                                            </t>
                                        </a>

                                        <div>
                                            <a t-attf-href="/showcase/creator/#{creator.id}"
                                               class="uikick-creator-name">
                                                <t t-esc="creator.name"/>
                                            </a>

                                            <div class="uikick-creator-role">
                                                <t t-esc="creator.role or 'Tác giả sản phẩm'"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="uikick-creator-meta">
                                        <span>
                                            <t t-esc="creator.project_count"/>
                                            dự án đã đăng
                                        </span>

                                        <t t-if="creator.location_id">
                                            <span>•</span>
                                            <span>
                                                <t t-esc="creator.location_id.name"/>
                                            </span>
                                        </t>
                                    </div>

                                    <p class="uikick-creator-bio">
                                        <t t-if="creator.bio">
                                            <t t-esc="creator.bio[:160]"/>
                                            <t t-if="len(creator.bio) > 160">...</t>
                                        </t>

                                        <t t-else="">
                                            <t t-esc="creator.name"/>
                                            là đội ngũ kỹ sư và nhà thiết kế đam mê tạo ra những sản phẩm khiến bạn phải
                                            ngạc nhiên.
                                        </t>
                                    </p>

                                    <a
                                       t-attf-href="/showcase/creator/#{creator.id}"
                                       class="btn btn-link p-0 uikick-link-btn">
                                       Tìm hiểu thêm
                                    </a>

<!--                                    <button t-else=""-->
<!--                                            class="btn btn-link p-0 uikick-link-btn">-->
<!--                                        Liên hệ tác giả-->
<!--                                    </button>-->
                                </div>

                            </t>

                            <div class="uikick-support-box">
                                <h3>Chia sẻ sản phẩm</h3>
                                <div class="uikick-share-icons">
                                    <button type="button" aria-label="Chia sẻ trên X">𝕏</button>
                                    <button type="button" aria-label="Chia sẻ trên Facebook">f</button>
                                    <button type="button" aria-label="Chia sẻ trên LinkedIn">in</button>
                                    <button type="button" aria-label="Chia sẻ qua email">📧</button>
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
