<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eaut_showcase_comment_list" model="ir.ui.view">
        <field name="name">eaut_showcase.comment.list</field>
        <field name="model">eaut_showcase.comment</field>
        <field name="arch" type="xml">
            <list string="Bình luận" decoration-muted="state == 'rejected'">
                <field name="create_date" string="Ngày gửi"/>
                <field name="project_id"/>
                <field name="name"/>
                <field name="content"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <button name="action_approve" type="object" string="Duyệt" icon="fa-check"
                        invisible="state == 'approved'"/>
                <button name="action_reject" type="object" string="Từ chối" icon="fa-times"
                        invisible="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_showcase_comment_form" model="ir.ui.view">
        <field name="name">eaut_showcase.comment.form</field>
        <field name="model">eaut_showcase.comment</field>
        <field name="arch" type="xml">
            <form string="Bình luận">
                <header>
                    <button name="action_approve" type="object" string="Duyệt"
                            class="btn-primary" invisible="state == 'approved'"/>
                    <button name="action_reject" type="object" string="Từ chối"
                            invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên người bình luận"/></h1>
                    </div>
                    <group>
                        <field name="project_id"/>
                    </group>
                    <group string="Nội dung">
                        <field name="content" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eaut_showcase_comment_search" model="ir.ui.view">
        <field name="name">eaut_showcase.comment.search</field>
        <field name="model">eaut_showcase.comment</field>
        <field name="arch" type="xml">
            <search string="Tìm bình luận">
                <field name="name"/>
                <field name="content"/>
                <field name="project_id"/>
                <filter name="pending" string="Chờ duyệt" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Đã duyệt" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_by_project" string="Dự án" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eaut_showcase_comment" model="ir.actions.act_window">
        <field name="name">Bình luận</field>
        <field name="res_model">eaut_showcase.comment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có bình luận nào từ khách.
            </p>
        </field>
    </record>

</odoo>